# ──────────────────────────────────────────────────────────
# Gartner Renewal Portal — Environment Variables
# ──────────────────────────────────────────────────────────
# In Vercel: Project → Settings → Environment Variables
# For local dev: copy this file to .env.local
# NEVER commit .env.local to git — it is in .gitignore
# ──────────────────────────────────────────────────────────

# AI provider: "anthropic" or "openai"
AI_PROVIDER=anthropic

# ── Anthropic (Claude) ────────────────────────────────────
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model options:
#   claude-sonnet-4-6          ← Recommended (smart + fast)
#   claude-opus-4-6            ← Most powerful
#   claude-haiku-4-5-20251001  ← Fastest / lowest cost
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (GPT) ─────────────────────────────────────────
# Only needed if AI_PROVIDER=openai
# Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o
