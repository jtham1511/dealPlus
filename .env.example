# ──────────────────────────────────────────────────────────
# Gartner Renewal Portal — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# In Vercel: add these in Project → Settings → Environment Variables
# NEVER commit actual API keys to git.
# ──────────────────────────────────────────────────────────

# ── AI PROVIDER ──────────────────────────────────────────
# Which AI provider to use: "anthropic" or "openai"
# Default: anthropic
AI_PROVIDER=anthropic

# ── ANTHROPIC (Claude) ────────────────────────────────────
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use. Options:
#   claude-sonnet-4-6          ← Recommended (smart + fast)
#   claude-opus-4-6            ← Most powerful (higher cost)
#   claude-haiku-4-5-20251001  ← Fastest (lowest cost)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OPENAI ───────────────────────────────────────────────
# Get your API key at: https://platform.openai.com/api-keys
# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use. Options:
#   gpt-4o          ← Recommended
#   gpt-4o-mini     ← Faster / lower cost
#   gpt-4-turbo     ← Legacy high quality
OPENAI_MODEL=gpt-4o
